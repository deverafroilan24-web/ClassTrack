# Local .bat launchers explicitly select SQLite, regardless of DATABASE_URL.
# Deployed dashboard selects postgres; auto preserves DATABASE_URL-based selection.
DATABASE_MODE=auto

# Supabase Database URL (used only in postgres/auto mode)
DATABASE_URL=

# Database path (SQLite file fallback)
DATABASE_PATH=hand_tracking.db

# Create/reset a local administrator: python manage_admin.py --database sqlite
# Supabase administrator via CLI: python manage_admin.py --database postgres
# Teachers are provisioned through /admin; legacy PIN login is disabled.

# Signing secret for eight-hour teacher sessions. Set a long random value in production.
AUTH_SECRET=

# Server host/port (for cloud deployment, use 0.0.0.0)
HOST=0.0.0.0
PORT=8000
