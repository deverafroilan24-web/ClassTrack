# Supabase Database URL (PostgreSQL connection string)
# Leave blank to fall back to SQLite hand_tracking.db
DATABASE_URL=

# Database path (SQLite file fallback)
DATABASE_PATH=hand_tracking.db

# Create/reset the administrator interactively: python manage_admin.py
# Teachers are provisioned through /admin; legacy PIN login is disabled.

# Signing secret for eight-hour teacher sessions. Set a long random value in production.
AUTH_SECRET=

# Required shared secret (requests are rejected when unset) for camera ingest and edge WebSocket connections.
# Use the same value in desktop-app/.env.
EDGE_API_KEY=

# Server host/port (for cloud deployment, use 0.0.0.0)
HOST=0.0.0.0
PORT=8000
