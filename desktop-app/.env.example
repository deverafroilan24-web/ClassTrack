# Remote Web Dashboard URL
# Use http://127.0.0.1:8000 for local development
# Use https://your-app.onrender.com for cloud deployment
WEB_DASHBOARD_URL=https://classtrack-mm41.onrender.com

# Pin a camera to a classroom for multi-camera deployments.
# Leave blank to follow the localhost teacher dashboard automatically.
SECTION_ID=

# Optional override: 1 follows the localhost dashboard, 0 keeps a fixed binding.
# START_ALL.bat explicitly sets this to 1.
CAMERA_FOLLOW_DASHBOARD=

# Camera source (0 = laptop webcam, 1 = external USB, or path to video file)
VIDEO_SOURCE=0

# YOLO model for pose estimation
YOLO_MODEL=yolov8n-pose.pt

# Detection confidence threshold
DETECTION_CONFIDENCE=0.50

# Target FPS for the vision loop
TARGET_FPS=30
